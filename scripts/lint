#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
linter=${CLANG_TIDY:-clang-tidy}
build_dir=${BUILD_DIR:-"$repo_root/build"}
compile_database="$build_dir/compile_commands.json"

if ! command -v "$linter" >/dev/null 2>&1; then
    echo "error: clang-tidy was not found; install LLVM or set CLANG_TIDY" >&2
    exit 1
fi

if [[ ! -f "$compile_database" ]]; then
    echo "error: $compile_database was not found" >&2
    echo "run ./scripts/configure before linting" >&2
    exit 1
fi

lint_files=()
while IFS= read -r -d '' file; do
    lint_files+=("$file")
done < <(
    find "$repo_root/src" "$repo_root/sdk/src" \
        -type f -name '*.c' -print0
)

if ((${#lint_files[@]} == 0)); then
    echo "error: no C source files found" >&2
    exit 1
fi

exec "$linter" -p "$build_dir" --warnings-as-errors='clang-analyzer-*' "${lint_files[@]}"
