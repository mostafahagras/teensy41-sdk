#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
formatter=${CLANG_FORMAT:-clang-format}

if ! command -v "$formatter" >/dev/null 2>&1; then
    echo "error: clang-format was not found; install LLVM or set CLANG_FORMAT" >&2
    exit 1
fi

case "${1:-}" in
    "")
        mode=write
        ;;
    --check)
        mode=check
        ;;
    *)
        echo "usage: $0 [--check]" >&2
        exit 2
        ;;
esac

format_files=()
while IFS= read -r -d '' file; do
    format_files+=("$file")
done < <(
    find "$repo_root/src" "$repo_root/sdk/src" "$repo_root/sdk/include/teensy" \
        -type f \( -name '*.c' -o -name '*.h' \) \
        ! -name 'imxrt.h' -print0
)

if ((${#format_files[@]} == 0)); then
    echo "error: no C source or header files found" >&2
    exit 1
fi

if [[ "$mode" == check ]]; then
    exec "$formatter" --dry-run --Werror --style=file "${format_files[@]}"
fi

exec "$formatter" -i --style=file "${format_files[@]}"
